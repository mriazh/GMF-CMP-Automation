# CMP Portal Credentials
CMP_USERNAME=your_cmp_username
CMP_PASSWORD=your_cmp_password

# GMF Mailbox Credentials (direct IMAP OTP retrieval)
GMF_EMAIL=your_gmf_email
GMF_PASSWORD=your_gmf_password

# GMF IMAP Configuration
GMF_IMAP_HOST=mail.gmf-aeroasia.co.id
GMF_IMAP_PORT=993

# Firefox Configuration
# Path to a persistent Firefox profile directory
FIREFOX_PROFILE_DIR=C:/path/to/firefox/profile

# Download directory for exported files
DOWNLOAD_DIR=C:/path/to/downloads

# OTP Configuration
# Timeout in seconds for OTP polling
OTP_TIMEOUT_SECONDS=120
# Poll interval in seconds
OTP_POLL_INTERVAL_SECONDS=5
# Allowed clock skew tolerance in seconds for OTP email timestamp comparison
OTP_CLOCK_SKEW_TOLERANCE_SECONDS=120

# Timezone for timestamp handling (default: Asia/Jakarta)
TIMEZONE=Asia/Jakarta
