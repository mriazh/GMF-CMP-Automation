# CMP Portal Credentials
CMP_USERNAME=your_cmp_username
CMP_PASSWORD=your_cmp_password

# Corporate Mailbox Credentials (direct IMAP OTP retrieval)
CORP_EMAIL=user@company.local
CORP_PASSWORD=your_corp_password

# Corporate IMAP Configuration
CORP_IMAP_HOST=mail.company.local
CORP_IMAP_PORT=993

# Firefox Configuration
# Path to a persistent Firefox profile directory
FIREFOX_PROFILE_DIR=C:/path/to/firefox/profile

# Download directory for browser staging and raw portal exports
DOWNLOAD_DIR=C:/path/to/downloads

# Monthly workbook template/output (project-relative by default)
# Tracks config/Daily-Data-Usage-M2M.example.xlsx in git; local Daily-Data-Usage-M2M.xlsx is gitignored
EXCEL_TEMPLATE_PATH=config/Daily-Data-Usage-M2M.xlsx
EXCEL_OUTPUT_DIR=output/reports

# Optional artifact directories (defaults: output/raw, output/images, output/logs)
RAW_XLSX_DIR=output/raw
IMAGE_DIR=output/images
LOGS_DIR=output/logs

# OTP Configuration
# Timeout in seconds for OTP polling
OTP_TIMEOUT_SECONDS=120
# Poll interval in seconds
OTP_POLL_INTERVAL_SECONDS=5
# Allowed clock skew tolerance in seconds for OTP email timestamp comparison
OTP_CLOCK_SKEW_TOLERANCE_SECONDS=120

# Timezone for timestamp handling (default: Asia/Jakarta)
TIMEZONE=Asia/Jakarta

# Browser Proxy Configuration (optional)
# CMP_PROXY_SERVER=socks5://127.0.0.1:40000

# Optional finite dashboard monitoring (0 disables additional cycles)
MONITOR_INTERVAL_SECONDS=0
MONITOR_MAX_CYCLES=0

# Host connectivity is read-only/off by default. Enable only after review.
CONNECTIVITY_ENABLED=false
CONNECTIVITY_ALLOW_CONNECT=false
CONNECTIVITY_ALLOW_DISCONNECT=false
CHECKPOINT_TRAC_PATH=C:/Program Files (x86)/CheckPoint/Endpoint Connect/trac.exe
CHECKPOINT_SITE=CORP-VPN
CHECKPOINT_GATEWAY=CORP-GATEWAY01
WARP_CLI_PATH=C:/Program Files/Cloudflare/Cloudflare WARP/warp-cli.exe
WARP_MODE=proxy
WARP_PROXY_PORT=40000
WARP_AUTO_CONNECT=true
WARP_TRACE_URL=https://www.cloudflare.com/cdn-cgi/trace

# Optional WhatsApp lifecycle notifications via a GOWA gateway
# Disabled by default. When enabled, full/scrape runs send one START event and
# exactly one terminal SUCCESS/FAILED event. Delivery is best-effort: a
# notification failure never changes the pipeline exit code.
# The values below are dummies - supply your real gateway and recipient only in
# the local (gitignored) .env on your own host.
WHATSAPP_NOTIFICATIONS_ENABLED=false
GOWA_BASE_URL=https://gowa-gateway.example.invalid
GOWA_TARGET_JID=0000000000000@s.whatsapp.net
# GOWA_DEVICE_ID=
# Short per-request timeout in seconds
GOWA_TIMEOUT_SECONDS=5
